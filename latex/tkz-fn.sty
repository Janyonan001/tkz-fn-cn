    f        = "\tkzfn@E{#2}",
    method   = "\tkzfn@E\tkzfn@method",
    interval = "\tkzfn@E\tkzfn@interval",
    number   = "\tkzfn@E\tkzfn@number",
    clip     = "\tkzfn@E\tkzfn@clip",
